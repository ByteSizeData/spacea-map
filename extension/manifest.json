{
  "manifest_version": 3,
  "name": "Space-A One-Button Autofill",
  "version": "1.3.1",
  "description": "Fills the official AMC Space-A sign-up form from your encrypted traveler vault, watches the 72-hr and 30-day boards (with public-aggregator fallback for terminals that publish nothing), and saves your confirmations. YOU do login, MFA, and the final Submit — always.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "downloads",
    "tabs",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.amc.af.mil/*",
    "https://*.mtmc.gov/*",
    "https://*.af.mil/*",
    "https://*.navy.mil/*",
    "https://*.marines.mil/*",
    "https://spacea.app/*",
    "https://popsspacea.com/*",
    "https://anyrouteai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Space-A Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amc.af.mil/*",
        "https://*.mtmc.gov/*",
        "https://*.af.mil/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://spacea.app/*",
        "https://popsspacea.com/*",
        "https://anyrouteai.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}